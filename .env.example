# Copy this file to .env and replace the example values with your own.
SECRET_KEY=change-this-to-a-long-random-value

# PostgreSQL connection string (required for deployment).
# Local development falls back to the SQLite file instance/inventory.db when
# DATABASE_URL is not set.
DATABASE_URL=postgresql://mysales_user:your-password@localhost:5432/mysales

# Set to 1 to enable the Flask debug/reloader with `python run.py`.
# Never enable it in production.
FLASK_DEBUG=0

# SMTP settings for sale receipt emails.
# For Gmail, use an App Password (not your normal account password).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-address@gmail.com
